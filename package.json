{
  "name": "bridgette-scoreboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "node --test test/*.test.mjs",
    "test:full": "astro check && node --test test/*.test.mjs && astro build",
    "quality:all": "pnpm exec terra-quality quality --all",
    "test:all": "pnpm run test:full"
  },
  "dependencies": {
