    "astro": "^7.2.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "sonner": "^2.0.8",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@eslint/js": "^9",
    "@headlessui/tailwindcss": "^0.2.2",
    "@tailwindcss/typography": "^0.5.20",
    "@terra-symposium/quality": "0.4.52",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.18",
    "autoprefixer": "^10.5.4",
    "eslint": "^9",
    "eslint-plugin-astro": "^1.3.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^16.4.0",
    "knip": "^6.33.0",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "tailwindcss-scrim-gradients": "^0.4.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8",
    "vidstack": "^0.4.5"
