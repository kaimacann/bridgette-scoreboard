{
	"$schema": "./node_modules/@terra-symposium/quality/quality.schema.json",
	"sourceRoots": ["src", "netlify", "test"],
	"extensions": [".astro", ".js", ".jsx", ".mjs", ".ts", ".tsx"],
	"aliases": { "@components/": "src/components/", "@lib/": "src/lib/", "@utils": "src/lib/utils" },
	"tsconfig": "tsconfig.json",
	"tools": { "eslint": "eslint", "knip": "knip", "prettier": "prettier", "tsc": "tsc" },
	"autofix": { "document": false, "knip": false, "lint": false, "name": false },
	"documentation": { "required": { "exportedFunctions": true } },
	"repeatedClasses": { "minimumCount": 3 },
	"regexDedup": { "minimumCount": 2 }
}
