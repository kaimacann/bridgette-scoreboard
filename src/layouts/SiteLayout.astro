---
import '../styles.css';

const { title, description = 'A shared community baseball scoreboard.' } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#ecfeff" />
		<title>{title}</title>
	</head>
	<body class="min-h-screen bg-cyan-50 text-slate-950 antialiased">
		<header class="sticky top-0 z-40 border-b border-cyan-950/15 bg-cyan-50/95 backdrop-blur">
			<nav class="mx-auto flex max-w-7xl items-center justify-between gap-6 px-5 py-4 sm:px-10" aria-label="Main navigation">
				<a class="font-mono text-lg font-semibold tracking-tight" href="/">Community Scoreboard</a>
				<div class="flex flex-wrap items-center gap-5 text-sm sm:gap-8">
					<a class="underline-offset-4 hover:underline" href="/">Scoreboard</a>
				</div>
			</nav>
		</header>
		<slot />
	</body>
</html>
