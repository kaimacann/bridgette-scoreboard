---
import '../styles.css';

const { title, description = 'A shared community baseball scoreboard.' } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#ecfeff" />
		<title>{title}</title>
	</head>
	<body class="min-h-screen bg-cyan-50 font-sans text-slate-950 antialiased">
		<slot />
	</body>
</html>
